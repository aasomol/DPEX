	(= (min_y) 0)
	(= (min_z) 0)
	(= (max_x) 2)
	(= (max_y) 2)
	(= (max_z) 2)
	(= (xl loc0) 0)
	(= (yl loc0) 2)
	(= (zl loc0) 2)
	(= (xl loc1) 1)
	(= (yl loc1) 0)
	(= (zl loc1) 1)
	(= (xl loc2) 2)
	(= (yl loc2) 2)
	(= (zl loc2) 1)
